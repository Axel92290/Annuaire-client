{% if erreurs %}
    <div
        id="resume-erreurs"
        class="notice notice-error error-summary"
        role="alert"
        tabindex="-1"
        data-focus-errors
    >
        <h2 class="eyebrow">Informations à corriger</h2>

        <ul>
            {% for field, messages in erreurs %}
                {% for message in messages %}
                    <li>
                        {% if field != '_global' %}
                            <a href="#{{ field }}">{{ message }}</a>
                        {% else %}
                            {{ message }}
                        {% endif %}
                    </li>
                {% endfor %}
            {% endfor %}
        </ul>
    </div>
{% endif %}

{% if apercuValide %}
    <div class="notice" role="status">
        <p>
            Les informations sont valides.
            Cet aperçu n’enregistre aucun client.
        </p>
    </div>
{% endif %}

<form
    method="post"
    action="{{ ecritureActive ? actionFormulaire : actionApercu }}"
    class="client-form"
    novalidate
    data-client-form
>
    <input type="hidden" name="_token" value="{{ csrfToken }}">

    {% if not ecritureActive %}
        <p class="form-explanation">
            Vous pouvez vérifier les informations.
            L’enregistrement reste désactivé dans cette démonstration.
        </p>
    {% endif %}

    {% set fields = {
        nom: {
            label: 'Nom',
            type: 'text',
            max: 100,
            autocomplete: 'family-name',
            half: true
        },
        prenom: {
            label: 'Prénom',
            type: 'text',
            max: 100,
            autocomplete: 'given-name',
            half: true
        },
        email: {
            label: 'E-mail',
            type: 'email',
            max: 254,
            autocomplete: 'email',
            half: false
        },
        telephone: {
            label: 'Téléphone',
            type: 'tel',
            max: 30,
            autocomplete: 'tel',
            half: true
        },
        adresse: {
            label: 'Adresse',
            type: 'text',
            max: 255,
            autocomplete: 'street-address',
            half: false
        },
        codePostal: {
            label: 'Code postal',
            type: 'text',
            max: 20,
            autocomplete: 'postal-code',
            half: true
        },
        ville: {
            label: 'Ville',
            type: 'text',
            max: 100,
            autocomplete: 'address-level2',
            half: true
        }
    } %}

    <div class="row gx-4">
        {% for name, field in fields %}
            <div class="{{ field.half ? 'col-md-6' : 'col-12' }} field-group">
                <label class="form-label" for="{{ name }}">
                    {{ field.label }}
                    {% if name == 'nom' %}
                        <span aria-hidden="true">*</span>
                    {% endif %}
                </label>

                <input
                    class="form-control {{ erreurs[name] is defined
                        ? 'field-invalid'
                        : ''
                    }}"
                    id="{{ name }}"
                    name="{{ name }}"
                    type="{{ field.type }}"
                    value="{{ valeurs[name] }}"
                    maxlength="{{ field.max }}"
                    autocomplete="{{ field.autocomplete }}"
                    {% if name == 'nom' %}required{% endif %}
                    {% if erreurs[name] is defined %}
                        aria-invalid="true"
                        aria-describedby="{{ name }}-error"
                    {% elseif name == 'email' %}
                        aria-describedby="email-help"
                    {% endif %}
                >

                {% if erreurs[name] is defined %}
                    <div id="{{ name }}-error" class="field-error">
                        {% for message in erreurs[name] %}
                            <p>{{ message }}</p>
                        {% endfor %}
                    </div>
                {% elseif name == 'email' %}
                    <p id="email-help" class="field-help">
                        Format attendu : nom@domaine.fr
                    </p>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <div class="form-actions">
        <button
            class="btn btn-primary"
            type="submit"
            data-submit-label
        >
            {{ ecritureActive
                ? 'Enregistrer'
                : 'Vérifier le formulaire'
            }}
        </button>

        <a
            class="text-action"
            href="{{ client
                ? path('clients_show', {id: client.id})
                : path('clients_index')
            }}"
        >
            Annuler
        </a>
    </div>

    <p
        class="visually-hidden"
        role="status"
        data-submit-status
    ></p>
</form>