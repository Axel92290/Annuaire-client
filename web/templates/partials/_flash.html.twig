{% for flash in messagesFlash %}
    <div
        class="notice {{ flash.type == 'error' ? 'notice-error' : '' }}"
        role="{{ flash.type == 'error' ? 'alert' : 'status' }}"
    >
        <span class="eyebrow">
            {% if flash.type == 'success' %}
                Confirmation
            {% elseif flash.type == 'error' %}
                Attention
            {% else %}
                Information
            {% endif %}
        </span>

        <p>{{ flash.message }}</p>
    </div>
{% endfor %}