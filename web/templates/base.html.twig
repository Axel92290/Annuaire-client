<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>{% block title %}Annuaire clients{% endblock %}</title>

    <link
        rel="stylesheet"
        href="/assets/vendor/bootstrap/bootstrap.min.css"
    >
    <link rel="stylesheet" href="/assets/css/app.css">

    <script src="/assets/js/app.js" defer></script>
</head>
<body>
    <a class="skip-link" href="#contenu">
        Aller au contenu
    </a>

    <header class="site-header">
        <nav
            class="page-container header-inner"
            aria-label="Navigation principale"
        >
            <a
                class="nav-label"
                href="{{ path('clients_index') }}"
            >
                Clients
            </a>

            <a
                class="wordmark"
                href="{{ path('clients_index') }}"
                aria-label="Annuaire — accueil"
            >
                [ MAISON ]
            </a>

            <span class="nav-label header-context">
                Annuaire clients
            </span>
        </nav>
    </header>

    {% if modeDemo %}
        <div class="demo-banner">
            <div class="page-container">
                Démonstration · Données fictives ·
                Aucun enregistrement réel
            </div>
        </div>
    {% endif %}

    <main
        id="contenu"
        class="page-container main-content"
        tabindex="-1"
    >
        {% include 'partials/_flash.html.twig' with {
            messagesFlash: messagesFlash
        } only %}

        {% block content %}{% endblock %}
    </main>

    <footer class="page-container site-footer">
        <span>Annuaire clients</span>
        <span>Un répertoire, simplement.</span>
    </footer>
</body>
</html>