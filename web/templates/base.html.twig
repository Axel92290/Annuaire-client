{#
   Layout commun. BaseController fournit modeDemo et messagesFlash ; services.php fournit
   utilisateur, path() et csrf_token(). Les valeurs affichées restent échappées automatiquement.
#}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        >

        <title>{% block title %}Annuaire clients{% endblock %}</title>

        <link
            rel="stylesheet"
            href="/assets/vendor/bootstrap/bootstrap.min.css"
        >
        <link rel="stylesheet" href="/assets/css/app.css">

        {#
           defer attend la construction du DOM ; le script est externe pour respecter la CSP.
        #}
        <script src="/assets/js/app.js" defer></script>
    </head>
    <body>
        {#
           Lien d’évitement clavier vers le main ; sa cible accepte le focus grâce à
           tabindex=-1.
        #}
        <a class="skip-link" href="#contenu">
            Aller au contenu
        </a>

        <header class="site-header">
            <nav
                class="page-container header-inner"
                aria-label="Navigation principale"
            >
                <a
                    class="nav-label"
                    href="{{ path('clients_index') }}"
                >
                    Clients
                </a>

                <a
                    class="wordmark"
                    href="{{ path('clients_index') }}"
                    aria-label="Annuaire — accueil"
                >
                    [ MAISON ]
                </a>

                {% if utilisateur %}
                    <div class="header-context">
                        <span>{{ utilisateur }}</span>

                        {#
                           Déconnexion volontaire par POST et jeton propre à cette action,
                           jamais via un lien GET.
                        #}
                        <form
                            method="post"
                            action="{{ path('auth_logout') }}"
                            class="d-inline"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('auth_logout') }}"
                            >

                            <button class="btn btn-outline-primary" type="submit">
                                Déconnexion
                            </button>
                        </form>
                    </div>
                {% else %}
                    <span class="nav-label header-context">
                        Annuaire clients
                    </span>
                {% endif %}
            </nav>
        </header>

        {% if modeDemo %}
            <aside class="demo-banner" aria-label="Mode démonstration">
                <div class="page-container">
                    Démonstration · Données fictives ·
                    Aucun enregistrement réel
                </div>
            </aside>
        {% endif %}

        <main
            id="contenu"
            class="page-container main-content"
            tabindex="-1"
        >
            {% include 'partials/_flash.html.twig' with {
            messagesFlash: messagesFlash
        } only %}

            {% block content %}{% endblock %}
        </main>

        <footer class="page-container site-footer">
            <span>Annuaire clients</span>
            <span>Un répertoire, simplement.</span>
        </footer>
    </body>
</html>
